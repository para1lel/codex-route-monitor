+
+func TestWindowProviderFiltersAndToolAllowlist(t *testing.T) {
+	d := t.TempDir()
+	if err := os.WriteFile(filepath.Join(d, "index.html"), []byte("<p>fixture</p>"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	read := func(filter, tools string) *WindowSpec {
+		t.Helper()
+		pkg := `{"magpie":{"page":{"file":"index.html"},"panels":[{"slot":"provider","file":"index.html"` + filter + `}]` + tools + `}}`
+		if err := os.WriteFile(filepath.Join(d, "package.json"), []byte(pkg), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		w, _ := Window(d)
+		if w == nil || w.Page == nil || len(w.Panels) != 1 {
+			t.Fatalf("window lost for %s: %+v", pkg, w)
+		}
+		return w
+	}
+	w := read(`,"providers":[" codex ","codex","","openai"]`, `,"tools":[" codex_route_scan ","codex_route_scan","status-2","tools:own","other/tool","*","", "`+strings.Repeat("a", 49)+`"]`)
+	if !slices.Equal(w.Panels[0].Providers, []string{"codex", "openai"}) {
+		t.Errorf("providers: %v", w.Panels[0].Providers)
+	}
+	if !slices.Equal(w.Tools, []string{"codex_route_scan", "status-2"}) {
+		t.Errorf("tools: %v", w.Tools)
+	}
+	if w := read("", ""); w.Panels[0].Providers != nil || len(w.Tools) != 0 {
+		t.Errorf("absent grants: %+v", w)
+	}
+	for _, raw := range []string{`[]`, `null`, `"codex"`, `{}`, `["codex",7]`} {
+		w := read(`,"providers":`+raw, `,"tools":`+raw)
+		if w.Panels[0].Providers == nil || len(w.Panels[0].Providers) != 0 {
+			t.Errorf("filter %s became unfiltered: %v", raw, w.Panels[0].Providers)
+		}
+		if len(w.Tools) != 0 {
+			t.Errorf("tools %s granted %v", raw, w.Tools)
+		}
+	}
+}
