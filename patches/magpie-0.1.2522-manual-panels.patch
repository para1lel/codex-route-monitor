diff --git a/internal/gui/pluginpage_tools.go b/internal/gui/pluginpage_tools.go
new file mode 100644
index 0000000000000000000000000000000000000000..baf98119279da860882a307e5b854c6f094fad11
--- /dev/null
+++ b/internal/gui/pluginpage_tools.go
@@ -0,0 +1,130 @@
+package gui
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"slices"
+
+	"github.com/yetone/magpie/internal/gwtool"
+	"github.com/yetone/magpie/internal/plugin"
+)
+
+const pageToolArgsMax = 64 << 10
+const pageToolReplyMax = 1 << 20
+
+// These seams keep permission tests out of the real plugin host and network.
+var pageTools = plugin.Tools
+var pageRunTool = plugin.RunTool
+
+// pageToolAllowed checks the current installed entry and window declaration,
+// not a spec or permission claimed by a frame. It is also checked after listing
+// tools, since starting the host can take time.
+func pageToolAllowed(spec, name string) error {
+	list, err := plugin.ReadList()
+	if err != nil {
+		return err
+	}
+	for _, e := range list.Plugins {
+		if e.Spec != spec || e.Off {
+			continue
+		}
+		w, _ := plugin.Window(plugin.Target(spec))
+		if w != nil && slices.Contains(w.Tools, name) {
+			return nil
+		}
+	}
+	return fmt.Errorf("no plugin page tool %q for %q", name, spec)
+}
+
+// pluginPageTool is the window's own-tool bridge. The sandbox cannot reach
+// this API (noFramedAPI); pluginpages.js supplies the identified frame's spec.
+func pluginPageTool(rw http.ResponseWriter, r *http.Request) {
+	var in struct {
+		Spec string          `json:"spec"`
+		Name string          `json:"name"`
+		Args json.RawMessage `json:"args"`
+	}
+	// Bound the whole envelope too, while allowing a full 64 KiB args object.
+	d := json.NewDecoder(http.MaxBytesReader(rw, r.Body, 2*pageToolArgsMax))
+	if err := d.Decode(&in); err != nil {
+		fail(rw, err)
+		return
+	}
+	if err := d.Decode(new(any)); err != io.EOF {
+		fail(rw, errors.New("a tool call is one JSON object"))
+		return
+	}
+	args := bytes.TrimSpace(in.Args)
+	if len(args) > pageToolArgsMax || len(args) == 0 || args[0] != '{' {
+		fail(rw, errors.New("a tool's arguments are a JSON object of at most 64 KiB"))
+		return
+	}
+	if err := pageToolAllowed(in.Spec, in.Name); err != nil {
+		pageToolDenied(rw, err)
+		return
+	}
+	if !gwtool.Served(gwtool.PluginTools) {
+		pageToolDenied(rw, errors.New("magpie's Plugin tools plugin is off"))
+		return
+	}
+	tools, err := pageTools(r.Context())
+	if err != nil {
+		pageToolFail(rw, err)
+		return
+	}
+	found := false
+	for _, p := range tools {
+		if p.Spec == in.Spec && slices.ContainsFunc(p.Tools, func(t plugin.Tool) bool { return t.Name == in.Name }) {
+			found = true
+			break
+		}
+	}
+	if !found {
+		pageToolDenied(rw, fmt.Errorf("no tool %q for plugin %q", in.Name, in.Spec))
+		return
+	}
+	if err := pageToolAllowed(in.Spec, in.Name); err != nil {
+		pageToolDenied(rw, err)
+		return
+	}
+	if !gwtool.Served(gwtool.PluginTools) {
+		pageToolDenied(rw, errors.New("magpie's Plugin tools plugin is off"))
+		return
+	}
+	text, err := pageRunTool(r.Context(), in.Spec, in.Name, args, "plugin-page")
+	if err != nil {
+		pageToolFail(rw, err)
+		return
+	}
+	// Bound the encoded response too: escaping can make JSON larger than text.
+	if len(text) > pageToolReplyMax {
+		fail(rw, errors.New("a tool's reply exceeds 1 MiB"))
+		return
+	}
+	out, err := json.Marshal(struct {
+		Text string `json:"text"`
+	}{text})
+	if err != nil || len(out) > pageToolReplyMax {
+		fail(rw, errors.New("a tool's reply exceeds 1 MiB"))
+		return
+	}
+	rw.Header().Set("Content-Type", "application/json")
+	_, _ = rw.Write(out)
+}
+
+func pageToolDenied(rw http.ResponseWriter, err error) {
+	rw.Header().Set("Content-Type", "application/json")
+	rw.WriteHeader(http.StatusForbidden)
+	_ = json.NewEncoder(rw).Encode(map[string]string{"error": err.Error()})
+}
+
+func pageToolFail(rw http.ResponseWriter, err error) {
+	if len(err.Error()) > pageToolReplyMax/8 {
+		err = errors.New("a tool's error exceeds 1 MiB")
+	}
+	fail(rw, err)
+}
