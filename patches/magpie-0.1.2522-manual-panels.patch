+	pageTools = func(context.Context) ([]plugin.PluginTools, error) {
+		lists++
+		return []plugin.PluginTools{{Spec: on, Tools: []plugin.Tool{{Name: "scan"}, {Name: "private"}}}, {Spec: first, Tools: []plugin.Tool{{Name: "scan"}, {Name: "unknown"}}}}, nil
+	}
+	pageRunTool = func(_ context.Context, spec, name string, args json.RawMessage, agent string) (string, error) {
+		runs++
+		if spec != on && spec != first || name != "scan" || string(args) != `{"enabled":true}` || agent != "plugin-page" {
+			t.Errorf("run crossed binding: %q %q %s %q", spec, name, args, agent)
+		}
+		return `{"ok":true}`, nil
+	}
+	gate := gwtool.Gate()
+	t.Cleanup(gate)
+	serve := gwtool.Serve(gwtool.PluginTools)
+	t.Cleanup(serve)
+	h := pageMux()
+	post := func(spec, name, args string) *httptest.ResponseRecorder {
+		t.Helper()
+		b, _ := json.Marshal(map[string]any{"spec": spec, "name": name, "args": json.RawMessage(args)})
+		return do(h, httptest.NewRequest("POST", "/api/plugin-pages/tool", strings.NewReader(string(b))))
+	}
+	for _, spec := range []string{on, first} {
+		w := post(spec, "scan", `{"enabled":true}`)
+		if w.Code != 200 || w.Body.String() != `{"text":"{\"ok\":true}"}` {
+			t.Fatalf("own call: %d %s", w.Code, w.Body)
+		}
+	}
+	// unknown is declared by on, but is only implemented by first. Never
+	// resolve it by name across plugins, even when another spec gives it.
+	for _, tc := range []struct{ spec, name string }{{off, "scan"}, {"missing", "scan"}, {on, "private"}, {on, "unknown"}} {
+		before := runs
+		w := post(tc.spec, tc.name, `{}`)
+		if w.Code != http.StatusForbidden || runs != before {
+			t.Errorf("denied %q %q: %d %s; runs=%d", tc.spec, tc.name, w.Code, w.Body, runs)
+		}
+	}
+	// Filter and allowlist reach both JSON contracts; absent tools is [].
+	var panels []pluginPanel
+	w := do(h, httptest.NewRequest("GET", "/api/plugin-panels", nil))
+	if err := json.Unmarshal(w.Body.Bytes(), &panels); err != nil || len(panels) == 0 || len(panels[0].Tools) != 2 || len(panels[0].Providers) != 1 || panels[0].Providers[0] != "codex" {
+		t.Fatalf("panel metadata: %s %v", w.Body, err)
+	}
+	var pages []pluginPage
+	w = do(h, httptest.NewRequest("GET", "/api/plugin-pages", nil))
+	if err := json.Unmarshal(w.Body.Bytes(), &pages); err != nil || len(pages) < 2 || len(pages[0].Tools) != 2 || pages[1].Tools == nil {
+		t.Fatalf("page metadata: %s %v", w.Body, err)
+	}
+
+	for _, args := range []string{`null`, `[]`, `"x"`, `1`, `true`, `{"x":"` + strings.Repeat("x", pageToolArgsMax) + `"}`} {
+		before := lists
+		w := post(on, "scan", args)
+		if w.Code != http.StatusBadRequest || lists != before {
+			t.Errorf("invalid args reached host: %d (lists %d -> %d)", w.Code, before, lists)
+		}
+	}
+	// A sandboxed iframe still cannot post this API itself.
+	r := httptest.NewRequest("POST", "/api/plugin-pages/tool", strings.NewReader(`{}`))
+	r.Header.Set("Origin", "null")
+	before := lists
+	if w := do(h, r); w.Code == 200 || lists != before {
+		t.Errorf("frame reached host: %d", w.Code)
+	}
+	serve()
+	before = lists
+	if w := post(on, "scan", `{}`); w.Code != http.StatusForbidden || lists != before {
+		t.Errorf("off gate reached host: %d", w.Code)
+	}
+}
+
+func TestPluginPageToolReplyAndFailures(t *testing.T) {
+	on, _, _, _ := panelPlugins(t)
+	file := filepath.Join(on, "package.json")
+	b, err := os.ReadFile(file)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var pkg map[string]any
+	if err := json.Unmarshal(b, &pkg); err != nil {
+		t.Fatal(err)
+	}
+	pkg["magpie"].(map[string]any)["tools"] = []string{"scan"}
+	b, _ = json.Marshal(pkg)
+	if err := os.WriteFile(file, b, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	oldTools, oldRun := pageTools, pageRunTool
+	t.Cleanup(func() { pageTools, pageRunTool = oldTools, oldRun })
+	serve := gwtool.Serve(gwtool.PluginTools)
+	t.Cleanup(serve)
+	pageTools = func(context.Context) ([]plugin.PluginTools, error) {
+		return []plugin.PluginTools{{Spec: on, Tools: []plugin.Tool{{Name: "scan"}}}}, nil
+	}
+	body, _ := json.Marshal(map[string]any{"spec": on, "name": "scan", "args": map[string]any{}})
+	post := func() *httptest.ResponseRecorder {
+		return do(pageMux(), httptest.NewRequest("POST", "/api/plugin-pages/tool", strings.NewReader(string(body))))
+	}
+	for _, text := range []string{strings.Repeat("x", pageToolReplyMax+1), strings.Repeat("\x00", pageToolReplyMax/2)} {
+		pageRunTool = func(context.Context, string, string, json.RawMessage, string) (string, error) { return text, nil }
+		if w := post(); w.Code == 200 || w.Body.Len() > pageToolReplyMax {
+			t.Errorf("oversized reply: %d %d", w.Code, w.Body.Len())
+		}
+	}
+	for _, msg := range []string{"fixture tool failure", strings.Repeat("x", pageToolReplyMax)} {
+		pageRunTool = func(context.Context, string, string, json.RawMessage, string) (string, error) {
+			return "", errors.New(msg)
+		}
+		if w := post(); w.Code != 400 || w.Body.Len() > pageToolReplyMax || !strings.Contains(w.Body.String(), "error") {
+			t.Errorf("tool error: %d %d", w.Code, w.Body.Len())
+		}
+	}
+	pageTools = func(context.Context) ([]plugin.PluginTools, error) { return nil, errors.New("fixture list failure") }
+	if w := post(); w.Code != 400 || !strings.Contains(w.Body.String(), "fixture list failure") {
+		t.Errorf("list error: %d %s", w.Code, w.Body)
+	}
+}
